{
  "name": "neuro-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Ohm Lab desktop studio for the Neuro N6 AI development board",
  "license": "GPL-3.0-only",
  "author": {
    "name": "Ohm Lab",
    "email": "team@ohmlab.co.uk"
  },
  "homepage": "https://neuron6.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ohmlab-ltd/NeuroStudio.git"
  },
  "bugs": {
    "url": "https://github.com/ohmlab-ltd/NeuroStudio/issues"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "package": "npm run build && electron-builder",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "serialport": "^13.0.0",
    "usb": "^2.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.2.2",
    "vitest": "^5.0.1",
    "wait-on": "^9.1.0"
  }
}
